{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "regex": "^/questions(\\.html)?$", "destination": "/chapters", "type": 301 },
      { "regex": "^/chapter-1(\\.html)?$", "destination": "/chapters/1", "type": 301 },
      { "regex": "^/chapter-2(\\.html)?$", "destination": "/chapters/2", "type": 301 },
      { "regex": "^/chapter-3(\\.html)?$", "destination": "/chapters/3", "type": 301 },
      { "regex": "^/chapter-4(\\.html)?$", "destination": "/chapters/4", "type": 301 },
      { "regex": "^/chapter-5(\\.html)?$", "destination": "/chapters/5", "type": 301 },
      { "regex": "^/chapter-6(\\.html)?$", "destination": "/chapters/6", "type": 301 },
      { "regex": "^/chapter-7(\\.html)?$", "destination": "/chapters/7", "type": 301 },
      { "regex": "^/chapter-8(\\.html)?$", "destination": "/chapters/8", "type": 301 },
      { "regex": "^/chapter-9(\\.html)?$", "destination": "/chapters/9", "type": 301 },
      { "regex": "^/chapter-10(\\.html)?$", "destination": "/chapters/10", "type": 301 },
      { "regex": "^/chapter-11(\\.html)?$", "destination": "/chapters/11", "type": 301 },
      { "regex": "^/chapter-12(\\.html)?$", "destination": "/chapters/12", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/arnie/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
