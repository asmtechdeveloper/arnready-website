# ── The dev/prod toggle (Anusha, 2026-07-18) ────────────────────────────────
# ONE switch drives BOTH the web client's Firebase project and the build-time
# content pull, so public content and auth can never come from different
# projects. There is deliberately NO DEFAULT: an unset or unrecognised value
# fails rather than guessing an environment.
#
# The site is a STATIC EXPORT, so this is a BUILD-TIME toggle — the selected
# values are inlined at build, and switching environments means rebuilding.
NEXT_PUBLIC_APP_ENV=dev

# ── Firebase Web SDK config, per environment ────────────────────────────────
# From Firebase Console → Project settings → General → Your apps → (web app)
# → SDK setup and configuration → Config.
#
# These NEXT_PUBLIC_ values are PUBLIC identifiers, not secrets — they ship
# inside the static bundle by design. Real secrets (service account keys)
# must never enter this repo in any form.
#
# The PROJECT_ID of the selected set is asserted against the environment
# (dev → arnready-dev, prod → arnready), so pasting the wrong project's config
# block into the wrong set fails loudly instead of silently authenticating
# users against the wrong project.
NEXT_PUBLIC_FIREBASE_DEV_API_KEY=
NEXT_PUBLIC_FIREBASE_DEV_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DEV_PROJECT_ID=arnready-dev
NEXT_PUBLIC_FIREBASE_DEV_APP_ID=

# Left blank until the prod Web App is registered in the `arnready` console.
# With NEXT_PUBLIC_APP_ENV=dev these are never read; setting APP_ENV=prod
# before they are filled in fails with a clear message rather than
# half-working.
NEXT_PUBLIC_FIREBASE_PROD_API_KEY=
NEXT_PUBLIC_FIREBASE_PROD_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROD_PROJECT_ID=arnready
NEXT_PUBLIC_FIREBASE_PROD_APP_ID=

# ── Service account key for scripts/export-content.mjs ──────────────────────
# A REAL secret: never committed, never placed inside this repo.
#
# Normally you do NOT need to set this. The export script derives the key path
# from NEXT_PUBLIC_APP_ENV:
#     ../ARNReady-App/scripts/serviceAccountKey.<dev|prod>.json
# Set it only for a one-off key in a non-standard location. The script still
# asserts that the key's project matches the toggle, so an override can never
# pull content from the wrong project.
ARNREADY_SA_KEY=
