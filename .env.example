# Firebase Web SDK config — from Firebase Console → Project settings → Web App.
# NO Web App is registered yet (10 Jul). Registering one is an Anusha decision;
# until then the site runs unsigned-free-tier only and these stay unset.
# These NEXT_PUBLIC_ values are public identifiers, not secrets — real secrets
# (service account keys) must never enter this repo in any form.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account key for scripts/export-content.mjs (build-time Firestore
# pull) — a REAL secret, never committed, never placed inside this repo.
# Defaults to ../ARNReady-App/scripts/serviceAccountKey.json if unset.
# Anusha: export this in your own shell profile, not in a checked-in file:
#   export ARNREADY_SA_KEY=/absolute/path/outside-this-repo/serviceAccountKey.json
ARNREADY_SA_KEY=
